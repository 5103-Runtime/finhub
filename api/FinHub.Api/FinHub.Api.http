@FinHub.Api_HostAddress = http://localhost:5013
@accountId =

# Authenticated requests rely on the HttpOnly cookie set by login, so run the login request first in the same client session.

GET {{FinHub.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{FinHub.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "your-password"
}

###

GET {{FinHub.Api_HostAddress}}/api/accounts
Accept: application/json

###

POST {{FinHub.Api_HostAddress}}/api/accounts
Content-Type: application/json

{
  "name": "Chequing",
  "institution": "RBC",
  "accountType": "chequing",
  "currency": "CAD"
}

###

GET {{FinHub.Api_HostAddress}}/api/accounts/{{accountId}}
Accept: application/json

###

PUT {{FinHub.Api_HostAddress}}/api/accounts/{{accountId}}
Content-Type: application/json

{
  "name": "Main Chequing",
  "institution": "RBC",
  "accountType": "chequing",
  "currency": "CAD"
}

###

DELETE {{FinHub.Api_HostAddress}}/api/accounts/{{accountId}}

###
